# Copy to .env and fill in, or set these in the host's settings (Railway:
# service > Variables). Never commit real values. Everything is optional:
# without a key or DSN that service is simply off.

# Server
PORT=8787
# 0.0.0.0 in a container; 127.0.0.1 keeps the server private to this computer.
HOST=127.0.0.1

# Playtest events: one JSON line per event. "off" disables the file.
# Default: data/events.jsonl in the repository. The container uses /data/events.jsonl
# (mount a volume at /data so it survives redeploys).
EVENTS_FILE=

# PostHog copy of the same events (anonymous ids only). EU cloud by default.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error tracking. SENTRY_DSN is used by the server and, unless
# SENTRY_DSN_WEB is set, by the browser too (a DSN is public by design).
SENTRY_DSN=
SENTRY_DSN_WEB=
SENTRY_ENV=playtest
